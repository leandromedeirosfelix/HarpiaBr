#version 450
// (hookshot) DLSS's result into the network's output (vk_dlss.cpp): squared back from the perceptual encoding into the linear
// R11G11B10F target the rest of OoT's frame reads, as the network does (taau_upscale.comp).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r11f_g11f_b10f) uniform writeonly image2D dst;
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, imageSize(dst)))) return;
    const vec3 c = max(texelFetch(src, g, 0).rgb, vec3(0.0));
    imageStore(dst, g, vec4(c * c, 1.0));
}
