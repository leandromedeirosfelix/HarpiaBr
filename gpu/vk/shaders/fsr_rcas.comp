#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;   // (EASU's picture, the same size)
layout(binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { float sharp; } pc;   // (FsrRcasCon's con.x: 2^-stops, 1 the strongest)
#define A_GPU 1
#define A_GLSL 1
#include "ffx/ffx_a.h"
#define FSR_RCAS_F 1
AF4 FsrRcasLoadF(ASU2 p) { return texelFetch(src, clamp(p, ivec2(0), textureSize(src, 0) - 1), 0); }   // (the border: its own pixels)
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx/ffx_fsr1.h"
void main() {
    const uvec2 g = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(g, uvec2(imageSize(dst))))) return;
    vec3 c;
    FsrRcasF(c.r, c.g, c.b, g, uvec4(floatBitsToUint(pc.sharp), 0u, 0u, 0u));
    imageStore(dst, ivec2(g), vec4(c, 1.0));
}
