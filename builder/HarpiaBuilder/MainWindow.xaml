<Window x:Class="HarpiaBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harpia Builder" Width="680" Height="580" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource Caption}" Click="Minimize" ToolTip="Minimize">
        <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button Style="{StaticResource Caption}" Click="CloseWindow" ToolTip="Close">
        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
    </StackPanel>

    <!-- Setup -->
    <Grid x:Name="SetupPage" Grid.Row="1" Margin="40,8,40,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <Grid>
          <TextBlock Text="Harpia Builder" Style="{StaticResource Heading}"/>
          <ComboBox x:Name="LanguageBox" Style="{StaticResource Choice}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="190"
                    AutomationProperties.Name="Language" SelectionChanged="LanguageChanged"/>
        </Grid>
        <TextBlock x:Name="Subtitle" Style="{StaticResource Note}" Margin="0,6,0,0"/>
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,32,0,0">
        <Grid Margin="0,0,0,10">
          <TextBlock x:Name="GameFilesLabel" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
          <Border HorizontalAlignment="Right" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="7" Padding="2">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="UseNup" Style="{StaticResource Seg}" GroupName="Source" IsChecked="True" Checked="SourceKindChanged"/>
              <RadioButton x:Name="UseFolders" Style="{StaticResource Seg}" GroupName="Source" Checked="SourceKindChanged"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="NupRow">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="NupPath" Style="{StaticResource Path}" TextChanged="PathsChanged"/>
          <Button x:Name="BrowseA" Grid.Column="1" Style="{StaticResource Quiet}" Margin="8,0,0,0" Click="BrowseNup"/>
        </Grid>

        <StackPanel x:Name="FolderRows" Visibility="Collapsed">
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="romfs" Style="{StaticResource Note}" VerticalAlignment="Center"/>
            <TextBox x:Name="RomfsPath" Grid.Column="1" Style="{StaticResource Path}" TextChanged="PathsChanged"/>
            <Button x:Name="BrowseB" Grid.Column="2" Style="{StaticResource Quiet}" Margin="8,0,0,0" Click="BrowseRomfs"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="exefs" Style="{StaticResource Note}" VerticalAlignment="Center"/>
            <TextBox x:Name="ExefsPath" Grid.Column="1" Style="{StaticResource Path}" TextChanged="PathsChanged"/>
            <Button x:Name="BrowseC" Grid.Column="2" Style="{StaticResource Quiet}" Margin="8,0,0,0" Click="BrowseExefs"/>
          </Grid>
        </StackPanel>

        <TextBlock x:Name="CheckText" Style="{StaticResource Note}" Margin="0,10,0,0" MinHeight="18"/>

        <TextBlock x:Name="SaveToLabel" Style="{StaticResource Label}" Margin="0,28,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="OutPath" Style="{StaticResource Path}" TextChanged="PathsChanged"/>
          <Button x:Name="BrowseD" Grid.Column="1" Style="{StaticResource Quiet}" Margin="8,0,0,0" Click="BrowseOut"/>
        </Grid>
      </StackPanel>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SpaceText" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <Button x:Name="BuildButton" Grid.Column="1" Style="{StaticResource Primary}" IsEnabled="False" Click="StartBuild"/>
      </Grid>
    </Grid>

    <!-- Building -->
    <Grid x:Name="BuildPage" Grid.Row="1" Margin="40,8,40,32" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock x:Name="BuildTitle" Style="{StaticResource Heading}"/>
        <TextBlock x:Name="BuildNote" Style="{StaticResource Note}" Margin="0,6,0,0"/>
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,28,0,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel x:Name="StageList"/>
        <TextBox x:Name="Log" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed" IsReadOnly="True" BorderThickness="1"
                 BorderBrush="{StaticResource Line}" Background="{StaticResource Raised}" Foreground="{StaticResource InkSoft}"
                 FontFamily="{StaticResource Mono}" FontSize="11" Padding="8" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="ShowLog" Style="{StaticResource Link}" VerticalAlignment="Center"
                      Checked="LogToggled" Unchecked="LogToggled"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="OpenButton" Style="{StaticResource Quiet}" Visibility="Collapsed" Click="OpenFolder" Margin="0,0,8,0"/>
          <Button x:Name="BackButton" Style="{StaticResource Quiet}" Visibility="Collapsed" Click="Back"/>
          <Button x:Name="CancelButton" Style="{StaticResource Quiet}" Click="CancelBuild"/>
          <Button x:Name="PlayButton" Style="{StaticResource Primary}" Visibility="Collapsed" Click="Play"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
