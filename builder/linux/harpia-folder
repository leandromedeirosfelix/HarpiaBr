#!/bin/sh
# The game folder's launcher, what harpia.exe is on Windows: Play, and Update when a newer release is out.
# The game itself is bin/harpia. This file is copied to harpia in the folder (nx2/make_game.py).
#
# It starts the builder installed by an update ($XDG_DATA_HOME/harpia/builder), or the builder= line in
# harpia_version.txt (the AppImage that built the folder). With neither, it starts the game.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

installed() {
    root=${HARPIA_BUILDER_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/harpia/builder}
    [ -f "$root/current" ] || return 1
    tag=$(tr -d ' \r\n' < "$root/current")
    [ -n "$tag" ] && [ -x "$root/versions/$tag/AppRun" ] || return 1
    printf '%s\n' "$root/versions/$tag/AppRun"
}

builder_line() {
    [ -f "$HERE/harpia_version.txt" ] || return 1
    path=
    while IFS= read -r line || [ -n "$line" ]; do
        case $line in
            builder=*) path=${line#builder=} ;;
        esac
    done < "$HERE/harpia_version.txt"
    [ -n "$path" ] && [ -x "$path" ] || return 1
    printf '%s\n' "$path"
}

run=$(installed || true)
if [ -z "$run" ]; then
    run=$(builder_line || true)
fi
if [ -n "$run" ]; then
    exec "$run" --launch "$HERE"
fi
if [ -x "$HERE/bin/harpia" ]; then
    cd "$HERE"
    exec ./bin/harpia
fi
echo "Harpia: the game (bin/harpia) is missing from this folder. Build it again with Harpia Builder." >&2
exit 1
