#!/bin/sh
# The Harpia AppImage: the builder window (builder/linux/harpia_builder.py) with everything it builds the game with -
# Python and the tools, clang and lld, a glibc 2.35 sysroot, FFmpeg, SDL2 and the Vulkan back end, built already.
#   Harpia.AppImage                  the builder window (Play is in the window, once a game is built)
#   Harpia.AppImage --play           start the game the builder saved, without opening the window
#   Harpia.AppImage --play <folder>  start the game in that folder
#   Harpia.AppImage <folder>         the same
#   Harpia.AppImage --cli <args>     nx2/make_game.py itself, e.g. --cli --nup game.nup --out ~/Games/Harpia
#   Harpia.AppImage --launch <dir>  the game folder's launcher: Play, and Update when a newer release is out
#   Harpia.AppImage --update <dir>  download the new release (only the parts that changed) and build that folder again
HERE="$(dirname "$(readlink -f "$0")")"
LIB="$HERE/usr/lib/harpia"
export HARPIA_TOOLS="$HERE/usr/share/harpia"
export EMSDK="$LIB/emsdk"
export HARPIA_SYSROOT="$LIB/sysroot"
export HARPIA_FFMPEG="$LIB/ffmpeg"
export HARPIA_VK_PREBUILT="$LIB/harpia_vk.so"
export HARPIA_SDL2="$LIB/libSDL2-2.0.so.0"
# (written into the game folder's harpia_version.txt, so its launcher finds this builder)
if [ -n "${APPIMAGE:-}" ]; then
    export HARPIA_BUILDER_EXE="$APPIMAGE"
else
    export HARPIA_BUILDER_EXE="$HERE/AppRun"
fi
PY="$HERE/usr/python/bin/python3"
if [ "${1:-}" = "--cli" ]; then
    shift
    exec "$PY" -I "$HARPIA_TOOLS/nx2/make_game.py" "$@"
fi
# Play is the same AppImage: the start script drops this image's libraries, then runs the built game.
if [ "${1:-}" = "--play" ]; then
    shift
    exec "$HARPIA_TOOLS/builder/linux/harpia-launch" "$@"
fi
if [ -n "${1:-}" ] && [ -d "$1" ]; then
    exec "$HARPIA_TOOLS/builder/linux/harpia-launch" "$1"
fi
exec "$PY" -I "$HARPIA_TOOLS/builder/linux/harpia_builder.py" "$@"
